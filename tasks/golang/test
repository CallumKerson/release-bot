#!/usr/bin/env bash
#MISE depends=["golang:mod-tidy-check"]
# Golden files and feature files are read by tests, so a change to any of them has to re-run the tests too
#MISE sources=["go.mod", "go.sum", "**/*.go", "**/testdata/**", "features/**"]
#MISE outputs={auto = true}

set -euxo pipefail

# gotestsum runs go test. CI sets GOTESTSUM_FORMAT and GOTESTSUM_JSONFILE to group the log and report the results
gotestsum -- ./...
